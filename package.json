    "check:pkg": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "vue": "^3.5.18",
    "lucide-vue-next": "^0.468.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.8.3",
    "vue-tsc": "^3.1.0",
    "@playwright/test": "^1.55.0"
  }
}
